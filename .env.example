# Firebase Configuration
# Copy to .env and fill from Firebase Console → Project settings → Your apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# After creating the Firebase project:
# 1. Enable Authentication → Email/Password
# 2. Create a Firestore database
# 3. Deploy rules: firebase deploy --only firestore:rules,firestore:indexes
#
# First admin bootstrap (Phase 1) — NOT a password:
# In Firestore Console create document platform_settings/bootstrap with field:
#   bootstrapAdminEmail = "you@example.com"
# Then register that email via /register. After success, platform_settings/lock is written.
# See docs/PHASE1_FOUNDATION.md

# Email — Superadmin → Settings → emailMode: live|sandbox
#
# === Vercel — Project Settings → Environment Variables ===
# Server-only (NO VITE_):
#   GMAIL_USER=
#   GMAIL_APP_PASSWORD=
#   GMAIL_FROM_NAME=HomeRental
#   FIREBASE_WEB_API_KEY=   # same as VITE_FIREBASE_API_KEY
#   FIREBASE_PROJECT_ID=    # same as VITE_FIREBASE_PROJECT_ID
# Client:
#   VITE_EMAIL_MODE=live
#   # no EMAIL_API_KEY — staff Firebase login authorizes /api/send
#
# === Local ===
#   npm run email:api
#   VITE_EMAIL_API_URL=http://localhost:8787
#   VITE_EMAIL_MODE=live
#
# Never put Gmail App Passwords in VITE_*

# WhatsApp (Phase 7) — DO NOT put access tokens in Vite env.
# Tokens belong in Cloud Functions / Secret Manager only.
# See docs/PHASE7_WHATSAPP.md and functions/whatsapp/README.md

# Phase 9 — Production hardening
# Client rate limits are in-app (localStorage); App Check / Functions quotas are optional next.
# Ops flags live in Firestore: platform_settings/hardening (admin Settings UI).
# Docs: docs/PHASE9_HARDENING.md, docs/SECURITY_REVIEW.md, docs/DEPLOY_ROLLBACK.md,
#       docs/BACKUPS_RESTORE.md, docs/STAFF_GUIDE.md
# Optional later (Functions only — never VITE_):
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
