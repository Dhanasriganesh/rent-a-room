rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isPropertyManager() {
      return isSignedIn() && userRole() == 'property_manager';
    }

    function isStaff() {
      return isAdmin() || isPropertyManager();
    }

    function isOwner() {
      return isSignedIn() && userRole() == 'owner';
    }

    function isRenter() {
      return isSignedIn() && userRole() == 'renter';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function owns(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function publicRegisterRole(role) {
      return role in ['owner', 'renter'];
    }

    function bootstrapConfigured() {
      return exists(/databases/$(database)/documents/platform_settings/bootstrap);
    }

    function bootstrapLocked() {
      return exists(/databases/$(database)/documents/platform_settings/lock);
    }

    function bootstrapEmail() {
      return get(/databases/$(database)/documents/platform_settings/bootstrap).data.bootstrapAdminEmail;
    }

    // Self-elevation to admin when bootstrap email matches and lock is absent
    function bootstrapRoleUpgrade() {
      return isSelf(request.auth.uid)
        && !bootstrapLocked()
        && bootstrapConfigured()
        && request.resource.data.role == 'admin'
        && request.resource.data.email.lower() == bootstrapEmail().lower();
    }

    // Self role change only when claiming a pending staff invitation (doc id = token)
    function inviteRoleUpgrade() {
      return isSelf(request.auth.uid)
        && request.resource.data.claimInviteToken is string
        && exists(/databases/$(database)/documents/staff_invitations/$(request.resource.data.claimInviteToken))
        && get(/databases/$(database)/documents/staff_invitations/$(request.resource.data.claimInviteToken)).data.status == 'pending'
        && get(/databases/$(database)/documents/staff_invitations/$(request.resource.data.claimInviteToken)).data.email.lower()
          == request.resource.data.email.lower()
        && get(/databases/$(database)/documents/staff_invitations/$(request.resource.data.claimInviteToken)).data.role
          == request.resource.data.role
        && request.resource.data.role in ['admin', 'property_manager'];
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // One named superadmin mailbox may self-elevate to admin (seed / recovery).
    // Keep the email in sync with scripts/seed-superadmin.mjs
    function superadminEmailElevate() {
      return isSelf(request.auth.uid)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'superadmin@gmail.com'
        && request.resource.data.role == 'admin'
        && request.resource.data.email.lower() == 'superadmin@gmail.com'
        && resource.data.role in ['renter', 'owner', 'property_manager', 'admin'];
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isStaff();

      // Public registration: never create privileged roles directly.
      // Staff may provision renter accounts (temp password + mustChangePassword).
      allow create: if (isSelf(userId) && publicRegisterRole(request.resource.data.role))
        || (
          isStaff()
          && request.resource.data.role == 'renter'
          && request.resource.data.accountStatus == 'active'
        );

      allow update: if isAdmin()
        || bootstrapRoleUpgrade()
        || inviteRoleUpgrade()
        || superadminEmailElevate()
        || (
          isStaff()
          && resource.data.role == 'renter'
          && request.resource.data.role == 'renter'
        )
        || (isSelf(userId) && roleUnchanged());

      allow delete: if isAdmin();
    }

    match /staff_profiles/{userId} {
      allow read: if isSelf(userId) || isStaff();
      allow create, update: if isAdmin() || isSelf(userId);
      allow delete: if isAdmin();
    }

    match /staff_invitations/{token} {
      // get by token ID is OK for pending (secret URL). list is staff-only to avoid leaking invites.
      allow get: if isStaff()
        || resource.data.status == 'pending'
        || (isSignedIn()
          && resource.data.email.lower() == request.auth.token.email.lower());
      allow list: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.status == 'pending'
          && resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /platform_settings/{docId} {
      // hardening flags are non-secret and may gate public apply/chat
      allow read: if isSignedIn() || docId == 'hardening';
      // Bootstrap doc is created manually in Console (admin SDK / console bypasses rules for some ops —
      // when using client, only admin can write settings except lock creation during bootstrap)
      allow create: if isAdmin()
        || (docId == 'lock'
          && isSignedIn()
          && !bootstrapLocked()
          && bootstrapConfigured());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /owner_profiles/{userId} {
      allow read: if true;
      allow create, update: if isSelf(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /owner_sites/{ownerId} {
      allow read: if true;
      allow create, update: if owns(ownerId) || isStaff();
      allow delete: if isAdmin();
    }

    match /renter_profiles/{userId} {
      allow read, write: if isSelf(userId) || isStaff();
    }

    match /properties/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if (isOwner() && request.resource.data.ownerId == request.auth.uid)
        || isStaff();
      allow update, delete: if isStaff()
        || (isOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /units/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if (isOwner() && request.resource.data.ownerId == request.auth.uid)
        || isStaff();
      allow update, delete: if isStaff()
        || (isOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'published'
        || isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if (isOwner() && request.resource.data.ownerId == request.auth.uid)
        || isStaff();
      allow update, delete: if isStaff()
        || (isOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /applications/{id} {
      allow read: if isStaff()
        || (isSignedIn() && (
          resource.data.renterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        ));
      allow create: if isStaff()
        || (isRenter() && request.resource.data.renterId == request.auth.uid);
      allow update: if isStaff()
        || (isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.renterId == request.auth.uid
        ))
        // Claim invite: attach self when application has no renter yet and email matches
        || (
          isRenter()
          && resource.data.renterId == null
          && request.resource.data.renterId == request.auth.uid
          && resource.data.applicantEmail is string
          && resource.data.applicantEmail.lower() == request.auth.token.email.lower()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['renterId', 'applicantEmail', 'applicantName', 'updatedAt'])
        );
    }

    match /conversations/{id} {
      allow read: if isStaff()
        || (isSignedIn() && request.auth.uid in resource.data.participantIds)
        || (isSignedIn() && resource.data.guestUserId == request.auth.uid);
      allow update: if isStaff()
        || (isSignedIn() && request.auth.uid in resource.data.participantIds)
        || (
          // Guest widget may bump lastMessage metadata only
          resource.data.channel == 'website'
          && request.resource.data.channel == 'website'
          && request.resource.data.guestEmail == resource.data.guestEmail
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderType', 'unreadForStaff', 'status', 'updatedAt'])
        );
      allow create: if isStaff()
        || (isSignedIn() && request.auth.uid in request.resource.data.participantIds)
        || (
          request.resource.data.channel == 'website'
          && request.resource.data.guestEmail is string
          && request.resource.data.guestEmail.size() > 3
          && request.resource.data.guestEmail.size() < 120
          && request.resource.data.status == 'open'
        );
    }

    match /conversation_members/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() || isStaff();
      allow update: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /messages/{id} {
      allow read: if isStaff()
        || isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.senderId == request.auth.uid)
        || (
          request.resource.data.senderType == 'guest'
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() < 4000
          && request.resource.data.conversationId is string
        );
    }

    match /message_delivery_logs/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() || isSignedIn();
      allow delete: if false;
    }

    // Phase 7 — WhatsApp templates & webhook event store (no tokens in docs)
    match /whatsapp_templates/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /whatsapp_webhook_events/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /tenancies/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update: if isStaff()
        || (isOwner() && (
          request.resource.data.ownerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        ));
    }

    match /tenancy_members/{id} {
      allow read: if isStaff()
        || (isSignedIn() && (
          resource.data.tenantUserId == request.auth.uid
          || isOwner()
        ));
      allow create, update: if isStaff() || isOwner();
    }

    match /document_requests/{id} {
      allow read: if isStaff()
        || (isSignedIn() && (
          resource.data.tenantUserId == request.auth.uid
          || isOwner()
        ));
      allow create, update: if isStaff()
        || isOwner()
        || isSelf(resource.data.tenantUserId);
    }

    // Private documents: uploader, staff, or owning landlord of related tenancy via client filter —
    // rules require staff, self (uploader), or admin. Owners no longer get blanket access to all docs.
    match /documents/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isStaff()
        || isSelf(resource.data.ownerUserId);
    }

    match /rent_charges/{id} {
      allow read: if isStaff()
        || (isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.responsibleTenantId == request.auth.uid
          || resource.data.tenantUserId == request.auth.uid
        ));
      allow create, update: if isStaff() || isOwner();
    }

    match /payments/{id} {
      allow read: if isStaff()
        || (isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.payerId == request.auth.uid
          || resource.data.tenantUserId == request.auth.uid
        ));
      allow create: if isStaff() || isOwner();
      allow update: if isStaff() || isOwner();
    }

    match /payment_events/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
    }

    match /payout_accounts/{id} {
      allow read, write: if isStaff()
        || (isSignedIn() && (
          resource == null
            ? request.resource.data.ownerId == request.auth.uid
            : resource.data.ownerId == request.auth.uid
        ));
    }

    match /requests/{id} {
      allow read: if isStaff()
        || (isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        ));
      allow create: if isSignedIn();
      allow update: if isStaff()
        || (isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        ));
    }

    match /request_comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    match /notifications/{id} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    match /audit_logs/{id} {
      allow read: if isStaff();
      allow create: if isSignedIn();
    }

    match /owner_domains/{id} {
      allow read: if true;
      allow write: if isOwner() || isStaff();
    }

    match /subscription_plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /owner_subscriptions/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /subscription_invoices/{id} {
      allow read: if isStaff() || isOwner();
      allow write: if isAdmin();
    }

    match /listing_media/{id} {
      allow read: if true;
      allow write: if isOwner() || isStaff();
    }

    // Phase 2 — staff-managed owner CRM + physical inventory
    match /owners/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    match /rooms/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.status == 'active';
      allow create: if isStaff()
        || (isOwner() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isStaff()
        || (isOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /beds/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.status == 'available';
      allow create: if isStaff()
        || (isOwner() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isStaff()
        || (isOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /rental_offers/{id} {
      allow read: if isStaff()
        || resource.data.status == 'active'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if isStaff()
        || isOwner();
    }

    // Phase 3 — bed allocations (staff-managed; tenant can read own)
    match /allocations/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.tenantUserId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff()
        || (
          // Claim invite: link tenant when allocation has no tenant yet
          isRenter()
          && resource.data.tenantUserId == null
          && request.resource.data.tenantUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['tenantUserId', 'updatedAt'])
        );
      allow delete: if false;
    }

    // Phase 4 — contract templates & contracts (private bodies; never public)
    match /contract_templates/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /contracts/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.tenantUserId == request.auth.uid)
        || (isSignedIn()
          && resource.data.applicantEmail is string
          && request.auth.token.email != null
          && resource.data.applicantEmail == request.auth.token.email.lower()
          && resource.data.status in ['approved', 'issued', 'signed', 'superseded']);
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /renewal_requests/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.tenantUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.tenantUserId == request.auth.uid;
      allow update: if isStaff()
        || (isSignedIn()
          && resource.data.tenantUserId == request.auth.uid
          && request.resource.data.status == 'cancelled');
      allow delete: if false;
    }

    // Phase 8 — move-in / move-out checklists (staff-managed; tenant read own)
    match /move_events/{id} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.tenantUserId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // Manager shareable browse catalogs — unlisted; only getDoc by known slug
    match /browse_links/{slug} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create, update, delete: if isStaff();
    }

    // Tenant onboarding — manager creates; invitee claims with matching email
    match /renter_invitations/{token} {
      allow get: if isStaff()
        || resource.data.status == 'pending'
        || (isSignedIn()
          && resource.data.email.lower() == request.auth.token.email.lower());
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff()
        || (isSignedIn()
          && resource.data.status == 'pending'
          && resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == request.auth.uid);
      allow delete: if isStaff();
    }
  }
}
