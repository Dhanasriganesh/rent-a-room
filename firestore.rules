rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isOwner() {
      return isSignedIn() && userDoc().role == 'owner';
    }

    function isRenter() {
      return isSignedIn() && userDoc().role == 'renter';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function owns(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /owner_profiles/{userId} {
      allow read: if true; // public brand fields used on owner sites
      allow create, update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /owner_sites/{ownerId} {
      allow read: if true;
      allow create, update: if owns(ownerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /renter_profiles/{userId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /properties/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner() && resource.data.ownerId == request.auth.uid;
    }

    match /units/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner() && resource.data.ownerId == request.auth.uid;
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'published' ||
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner() && resource.data.ownerId == request.auth.uid;
    }

    match /applications/{id} {
      allow read: if isSignedIn() && (
        resource.data.renterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isRenter() && request.resource.data.renterId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.renterId == request.auth.uid ||
        isAdmin()
      );
    }

    match /conversations/{id} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }

    match /conversation_members/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /messages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    match /tenancies/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create, update: if isOwner() && (
        request.resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    match /tenancy_members/{id} {
      allow read: if isSignedIn() && (
        resource.data.tenantUserId == request.auth.uid || isOwner() || isAdmin()
      );
      allow create, update: if isOwner() || isAdmin();
    }

    match /document_requests/{id} {
      allow read: if isSignedIn() && (
        resource.data.tenantUserId == request.auth.uid || isOwner() || isAdmin()
      );
      allow create, update: if isOwner() || isSelf(resource.data.tenantUserId) || isAdmin();
    }

    match /documents/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerUserId == request.auth.uid || isOwner() || isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isOwner() || isSelf(resource.data.ownerUserId) || isAdmin();
    }

    match /rent_charges/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.responsibleTenantId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isOwner() || isAdmin();
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isOwner() || isAdmin();
    }

    match /payment_events/{id} {
      allow read: if isAdmin() || isOwner();
      allow create: if isAdmin();
    }

    match /payout_accounts/{id} {
      allow read, write: if isSignedIn() && (
        resource == null
          ? request.resource.data.ownerId == request.auth.uid
          : resource.data.ownerId == request.auth.uid
      ) || isAdmin();
    }

    match /requests/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
    }

    match /request_comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    match /notifications/{id} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /owner_domains/{id} {
      allow read: if true;
      allow write: if isOwner() || isAdmin();
    }

    match /subscription_plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /owner_subscriptions/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /subscription_invoices/{id} {
      allow read: if isAdmin() || isOwner();
      allow write: if isAdmin();
    }

    match /listing_media/{id} {
      allow read: if true;
      allow write: if isOwner() || isAdmin();
    }
  }
}
